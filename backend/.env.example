# Neon pooled Postgres URL recommended for deployed/serverless environments.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?ssl=require
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
ARBITRATION_CONTRACT_ADDRESS=
REPUTATION_CONTRACT_ADDRESS=
FACTORY_CONTRACT_ADDRESS=
FRONTEND_ORIGINS=http://localhost:5173,https://your-meridian-app.vercel.app
INDEXER_POLL_INTERVAL_SECONDS=8
ADMIN_WALLET_ADDRESSES=GYOUR_ADMIN_FREIGHTER_WALLET
ADMIN_AUTH_SECRET=replace_with_a_random_32_character_or_longer_secret
ADMIN_SESSION_TTL_SECONDS=900
CRON_SECRET=replace_with_a_random_16_character_or_longer_secret
LOG_LEVEL=INFO
